# Copie para .env:  cp .env.example .env
# O arquivo .env NUNCA é versionado (ver .gitignore).

# ---- Banco de dados ----
DB_NAME=spacedrep
DB_USER=spacedrep
DB_PASSWORD=spacedrep_dev_only
DB_URL=jdbc:postgresql://localhost:5432/spacedrep

# ---- Aplicação ----
SERVER_PORT=8080
DEMO_USER_ID=1

# ---- Gemini (Dia 2) ----
# Obtenha em https://aistudio.google.com/apikey
# Em produção/CI: use GitHub Secrets, nunca este arquivo.
GEMINI_API_KEY=

# ---- JWT (Dia 2) ----
# Gere com: openssl rand -base64 64
JWT_SECRET=
JWT_EXPIRATION_HOURS=8
